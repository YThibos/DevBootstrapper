# Completion: a menu to select from, case-insensitive matching, results grouped by kind.
# Tool completions are generated by devup into tools/completions/zsh/ (docs/shell.md).

mkdir -p "$DEV_TOOLS/cache/zsh"
fpath=("$DEV_TOOLS/completions/zsh" $fpath)
autoload -Uz compinit
compinit -C -d "$DEV_TOOLS/cache/zsh/zcompdump"

zstyle ':completion:*' auto-description 'specify: %d'
zstyle ':completion:*' completer _expand _complete _correct _approximate
zstyle ':completion:*' format 'Completing %d'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' menu select=long
zstyle ':completion:*' matcher-list '' 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*'
zstyle ':completion:*' list-colors ''
zstyle ':completion:*' list-prompt %SAt %p: Hit TAB for more, or the character to insert%s
zstyle ':completion:*' select-prompt %SScrolling active: current selection at %p%s
zstyle ':completion:*' use-compctl false
zstyle ':completion:*' verbose true
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

# Completions that devup generates as scripts to source rather than as completion functions.
for __devboot_f in "$DEV_TOOLS"/completions/zsh/*.zsh(N); do
  . "$__devboot_f"
done
unset __devboot_f

__devboot_identity_names() {
  git config -f "$DEV_HOME/.local/git/identities.gitconfig" --name-only --get-regexp "^$1\..*\.$2\$" 2>/dev/null |
    sed -E "s/^$1\.(.*)\.$2\$/\1/"
}

__devboot_complete_gitid() {
  local -a candidates
  if (( CURRENT == 2 )); then
    candidates=(list add-account add-context link unlink remove-account remove-context default use as setup sync doctor)
  else
    case $words[2] in
      default | use | add-context | remove-context | link | unlink)
        if (( CURRENT == 3 )); then
          candidates=(${(f)"$(__devboot_identity_names context email)"})
          [[ $words[2] == use ]] && candidates+=(--clear)
        else
          candidates=(${(f)"$(__devboot_identity_names account host)"})
        fi ;;
      as | remove-account)
        candidates=(${(f)"$(__devboot_identity_names account host)"}) ;;
    esac
  fi
  compadd -a candidates
}

__devboot_complete_use_version() {
  local -a candidates
  if (( CURRENT == 2 )); then
    candidates=(${(f)"$(sed -n 's/^\([A-Za-z0-9_-]*\) = \[.*/\1/p' "$DEV_HOME/config/mise/config.toml")"})
  else
    candidates=(--reset ${(f)"$(use-version --list-values $words[2] 2>/dev/null)"})
  fi
  compadd -a candidates
}

__devboot_complete_mvnuse() { compadd -- --reset ${(f)"$(use-version --list-values maven 2>/dev/null)"} }
__devboot_complete_jdkuse() { compadd -- --reset ${(f)"$(use-version --list-values java 2>/dev/null)"} }
__devboot_complete_dev() { compadd help cheat docs ids up doctor startup-time version }
__devboot_complete_devup() { compadd -- --first-run --daily --skip --only --unlink --help }

compdef __devboot_complete_gitid gitid
compdef __devboot_complete_use_version use-version
compdef __devboot_complete_mvnuse mvnuse
compdef __devboot_complete_jdkuse jdkuse
compdef __devboot_complete_dev dev
compdef __devboot_complete_devup devup
