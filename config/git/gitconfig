# DevBootstrapper global git configuration, linked from ~/.gitconfig.
# Commit identities and forge accounts are machine-local and generated by gitid
# into ~/development/.local/git/ (docs/identities.md); a missing file is ignored.
[include]
	path = ~/development/.local/git/routing.gitconfig
[init]
	defaultBranch = main
[core]
	excludesFile = ~/development/config/git/ignore
	autocrlf = input
	pager = $HOME/development/bin/git-pager
	sshCommand = $HOME/development/bin/devboot-ssh
[interactive]
	diffFilter = $HOME/development/bin/git-pager --color-only
[credential]
	# Reset helpers from the system config, then let gitid pick the account per folder and host.
	helper =
	helper = !$HOME/development/bin/git-credential-devboot
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = default
[pull]
	ff = only
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[help]
	autocorrect = prompt
