#!/usr/bin/env bash
# git credential helper: answers "get" for HTTPS remotes with the token of the account
# resolved for the current directory and host (docs/identities.md). Prints nothing when
# no account applies, so git falls back to asking.
# A GitHub account without a token in .secrets uses the GitHub CLI's login for that user
# instead, so `gh auth login` alone is enough and `gh auth refresh -s <scope>` widens it.
set -uo pipefail

[ "${1:-}" = get ] || exit 0

# shellcheck source=lib/common.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"
# shellcheck source=lib/identity.sh
. "$DEV_HOME/lib/identity.sh"

protocol='' host=''
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  case $key in
    protocol) protocol=$value ;;
    host) host=$value ;;
  esac
done

[ "$protocol" = https ] && [ -n "$host" ] || exit 0
ctx=$(id_resolve_context "$PWD" 2>/dev/null || true)
acc=$(id_resolve_account "$ctx" "$host" 2>/dev/null) || exit 0
user=$(id_get "account.$acc.user")
if ! token=$(id_account_token "$acc"); then
  [ "$(id_get "account.$acc.forge")" = github ] || exit 0
  gh=$(devboot_find_real gh) || exit 0
  token=$("$gh" auth token -h "$host" -u "$user" 2>/dev/null) && [ -n "$token" ] || exit 0
fi
printf 'username=%s\npassword=%s\n' "$user" "$token"
