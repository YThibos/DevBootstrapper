# Machine settings for DevBootstrapper (docs/network.md). Copied to .local/profile.env by
# devup --first-run; .local/ is never committed. KEY=value lines, loaded into every shell.

# home (desktop PC) or work (work laptop). Also the default git context outside sources/.
DEV_PROFILE=home

# Corporate proxy, e.g. http://proxy.example:8080 (empty for none), and hosts that bypass it.
DEV_PROXY_URL=
DEV_NO_PROXY=localhost,127.0.0.1,::1

# Corporate root certificate (PEM), added to Ubuntu, every JDK and Node by devup.
DEV_CA_CERT=

# Maven mirror (Artifactory, Nexus, ...); credentials go in .secrets as MAVEN_MIRROR_USERNAME/PASSWORD.
DEV_MAVEN_MIRROR_URL=
DEV_MAVEN_MIRROR_OF=*

# npm registry mirror; its token goes in .secrets as NPM_REGISTRY_TOKEN.
DEV_NPM_REGISTRY=

# Windows-side tools folder, as seen from WSL.
DEV_WINDOWS_TOOLS=/mnt/c/development/tools
