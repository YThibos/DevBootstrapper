# DevBootstrapper secrets (docs/secrets.md). Copied to .secrets with mode 600; never committed.
# KEY=value lines, loaded into every shell. Keep values unquoted unless they contain spaces.

# Git forge tokens, one per account; gitid add-account adds the line for each new account.
# GITHUB_PERSONAL_TOKEN=
# GITHUB_WORK_TOKEN=
# GITLAB_WORK_TOKEN=

# Raises GitHub's API rate limit for mise downloads (a token without any scopes is enough).
# MISE_GITHUB_TOKEN=

# Package mirrors (only with DEV_MAVEN_MIRROR_URL / DEV_NPM_REGISTRY in .local/profile.env).
MAVEN_MIRROR_USERNAME=
MAVEN_MIRROR_PASSWORD=
NPM_REGISTRY_TOKEN=

# Claude Code API key, only when not logging in with a Claude account.
# ANTHROPIC_API_KEY=
